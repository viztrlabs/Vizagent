# ============================================
# VizTR Platform — Environment Variables
# ============================================
# Copy this file to .env.local for local development
# See docs/ENVIRONMENT-MATRIX.md for full reference
#
# Source: VIZTR-TECHSTACK-SELECTION.md + Phase plans
# Last verified: 2026-08-06

# === Supabase (Auth + DB + Storage + Edge Functions) ===
# Provider: Supabase (ADR 3.1) — NOT NextAuth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# === Cloudflare R2 (Object Storage — 3D assets, media, tiles) ===
# Provider: Cloudflare R2 (§8.3) — NOT AWS S3
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=viztr-assets-dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# === Redis (Cache + BullMQ Queues) ===
# MVP: Local Redis / Upstash / Railway
REDIS_URL=redis://localhost:6379

# === AI / LLM Providers ===
# Routing: OmniRoute → OpenAI → OpenRouter → Groq (§6.2)
OPENAI_API_KEY=your-openai-key
OPENROUTER_API_KEY=your-openrouter-key
GROQ_API_KEY=your-groq-key

# === Email ===
# Provider: Resend + react-email (§13.2) — NOT SendGrid
RESEND_API_KEY=your-resend-key

# === SMS / WhatsApp ===
# Provider: Twilio (§13.2)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# === Payments (Stripe — International) ===
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable

# === Payments (Razorpay — India market, Phase 5) ===
# Uncomment when Razorpay integration is implemented
# RAZORPAY_KEY_ID=your-razorpay-key
# RAZORPAY_KEY_SECRET=your-razorpay-secret

# === Observability ===
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# === Google Analytics (GA4 — consent-aware, Phase 2 Task 19) ===
# Injected via Settings table, not env var — see Phase 2 Task 19
# If needed as fallback:
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# === Vercel (Deployment) ===
VERCEL_TOKEN=your-vercel-token

# === Cloudflare Tunnel (Local ↔ Cloud bridge) ===
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# === GitHub (Content-as-Code, CI, PR automation) ===
GITHUB_TOKEN=your-github-pat

# === Application Config ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_XR_URL=http://localhost:3001
NODE_ENV=development
