# ------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.
# ------------------------------------------------------------------

# Supabase (Auth + DB + Storage + Edge Functions)
# Project URL + anon key: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role JWT (server-only, never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Prisma connection string: Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Cloudflare R2 (Object Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=viztr-assets-dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Redis (Cache + BullMQ Queues)
REDIS_URL=redis://localhost:6379

# Email
RESEND_API_KEY=your-resend-key

# Google OAuth (Calendar sync)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Pixel Streaming
NEXT_PUBLIC_SIGNALING_URL=wss://stream.viztr.io
NEXT_PUBLIC_METRICS_URL=https://metrics.viztr.io
CRON_SECRET=your-long-random-cron-secret

# Application Config
NEXT_PUBLIC_SITE_URL=http://localhost:3030
NEXT_PUBLIC_XR_URL=http://localhost:3001
