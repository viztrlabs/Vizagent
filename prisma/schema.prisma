// This is a reconstructed Prisma schema for the admin layer models.
// It includes only the models used by the admin services, plus the AuditLog model.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CLIENT
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  role          Role     @default(CLIENT)
  isSuspended   Boolean  @default(false)
  suspensionReason String?
  suspendedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String   @default("")

  // Relations
  tickets        SupportTicket[]   @relation("SupportTicketUserIdToUserId")
  sentMessages   SupportTicketMessage[] @relation("SupportTicketMessageSenderIdToUserId")
  exportRequests DataExportRequest[] @relation("DataExportRequestUserIdToUserId")
  impersonationAsAdmin ImpersonationLog[] @relation("ImpersonationLogAdmin")
  impersonationAsTarget ImpersonationLog[] @relation("ImpersonationLogTarget")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String?  // The initial message or description
  status    String   @default("open") // open, in_progress, resolved, closed
  priority  String   @default("low") // low, medium, high, urgent
  tenantId  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?

  // Relations
  user      User     @relation("SupportTicketUserIdToUserId", fields: [userId], references: [id])
  messages  SupportTicketMessage[] @relation("SupportTicketMessageTicketIdToSupportTicketId")
}

model SupportTicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String   // Could be user or admin
  content   String
  createdAt DateTime @default(now())
  tenantId  String   @default("")

  // Relations
  ticket    SupportTicket @relation("SupportTicketMessageTicketIdToSupportTicketId", fields: [ticketId], references: [id])
  sender    User     @relation("SupportTicketMessageSenderIdToUserId", fields: [senderId], references: [id])
}

model JobExecution {
  id        String   @id @default(uuid())
  jobId     String   // Identifier for the job type (e.g., "rendering", "backup")
  status    String   @default("pending") // pending, running, completed, failed, cancelled
  progress  Int?     @default(0) // 0-100
  error     String?  // Error message if failed
  attempts  Int      @default(0)
  finishedAt DateTime?
  failedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String   @default("")
}

model DataExportRequest {
  id        String   @id @default(uuid())
  userId    String
  format    String   // e.g., "csv", "json", "pdf"
  status    String   @default("pending") // pending, processing, completed, failed
  filePath  String?  // Path to the exported file
  requestedAt DateTime @default(now())
  completedAt DateTime?
  error     String?  // Error message if failed
  tenantId  String   @default("")

  // Relations
  user      User     @relation("DataExportRequestUserIdToUserId", fields: [userId], references: [id])
}

model ImpersonationLog {
  id        String   @id @default(uuid())
  adminUserId String   // The admin who initiated impersonation
  targetUserId String   // The user being impersonated
  status    String   @default("active") // active, revoked, expired
  expiresAt DateTime  // When the impersonation expires
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String   @default("")

  // Relations
  adminUser User     @relation("ImpersonationLogAdmin", fields: [adminUserId], references: [id])
  targetUser User     @relation("ImpersonationLogTarget", fields: [targetUserId], references: [id])
}

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

/// M13: CRM models — leads, contacts, deals, tasks
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStage {
  PROSPECT
  QUOTE
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id          String     @id @default(uuid())
  email       String     @unique
  name        String?
  company     String?
  phone       String?
  status      LeadStatus @default(NEW)
  source      String?    // how they found us
  tenantId    String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  contacts    Contact[]
  deals       Deal[]
  tasks       Task[]

  @@index([tenantId])
  @@index([status])
}

model Contact {
  id          String   @id @default(uuid())
  leadId      String
  name        String
  email       String?
  phone       String?
  role        String?    // job title at company
  tenantId    String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([leadId])
  @@index([tenantId])
}

model Deal {
  id          String    @id @default(uuid())
  leadId      String
  contactId   String?
  title       String
  stage       DealStage @default(PROSPECT)
  value       Float?
  currency    String    @default("USD")
  closeDate   DateTime?
  tenantId    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  lead        Lead      @relation(fields: [leadId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  tasks       Task[]

  @@index([leadId])
  @@index([stage])
  @@index([tenantId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  dueDate     DateTime?
  leadId      String?
  dealId      String?
  tenantId    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lead        Lead?    @relation(fields: [leadId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([tenantId])
}