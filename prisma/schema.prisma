generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// M0.5: role enum replaces the free-text `role String @default("client")` field.
// Maps to the locked hierarchy SUPER_ADMIN > ADMIN > USER (studio) > CLIENT.
enum Role {
  CLIENT
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT)
  avatarUrl String?
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects      Project[]
  deployments   Deployment[]
  subscriptions Subscription[]

  isSuspended          Boolean     @default(false)
  suspensionReason     String?
  suspendedAt          DateTime?

  @@map("users")
  @@index([tenantId])
  dataExportRequests   DataExportRequest[] @relation("DataExportRequestUserIdToUserId")
  impersonationLogsAsAdmin ImpersonationLog[] @relation("ImpersonationLogAdmin")
  impersonationLogsAsTarget ImpersonationLog[] @relation("ImpersonationLogTarget")
  supportTickets         SupportTicket[] @relation("SupportTicketUserIdToUserId")
  supportMessages        SupportMessage[] @relation("SupportMessageSenderIdToUserId")
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String?
  clientId     String    @map("client_id")
  serviceType  String    @default("tour") @map("service_type")
  status       String    @default("draft")
  settings     Json      @default("{\"cameraHeight\": 1.7, \"autoRotate\": false, \"hotspotStyle\": \"pin\"}")
  budget       Decimal?  @db.Decimal(10, 2)
  deadline     DateTime?
  publishedUrl String?   @map("published_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  tenantId     String    @map("tenant_id")

  client      User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets      Asset[]
  qaReports   QaReport[]
  deployments Deployment[]
  xrAssets    XrAsset[]

  @@index([clientId])
  @@index([status])
  @@index([tenantId])
  @@map("projects")
}

model Asset {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  fileName          String   @map("file_name")
  fileType          String   @map("file_type")
  fileSize          BigInt?  @map("file_size")
  storagePath       String   @map("storage_path")
  thumbnailPath     String?  @map("thumbnail_path")
  status            String   @default("uploaded")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  tenantId          String   @map("tenant_id")
  // M4: optimization fields
  optimizedPath     String?  @map("optimized_path")
  optimizedStatus   String?  @map("optimized_status")
  optimizedAt       DateTime? @map("optimized_at")
  tilingPath        String?  @map("tiling_path")
  tilingStatus      String?  @map("tiling_status")
  tilingAt          DateTime? @map("tiling_at")
  // optimization metadata
  originalWidth     Int?     @map("original_width")
  originalHeight    Int?     @map("original_height")
  optimizedWidth    Int?     @map("optimized_width")
  optimizedHeight   Int?     @map("optimized_height")
  compressionRatio  Float?   @map("compression_ratio")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId])
  @@map("assets")
}

model QaReport {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  qaStatus  String   @map("qa_status")
  checks    Json     @default("[]")
  issues    Json     @default("[]")
  checkedAt DateTime? @map("checked_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenantId  String   @map("tenant_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId])
  @@map("qa_reports")
}

model Deployment {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  environment String
  status      String
  previewUrl  String?   @map("preview_url")
  publicUrl   String?   @map("public_url")
  commitSha   String?   @map("commit_sha")
  deployedBy  String?   @map("deployed_by")
  deployedAt  DateTime? @map("deployed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  tenantId    String    @map("tenant_id")
  // M8: deployment mode and approval tracking
  mode        String
  approvalId  String?   @unique @map("approval_id")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployer User?   @relation(fields: [deployedBy], references: [id])
  approval Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([tenantId])
  @@map("deployments")
}

model XrAsset {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  type          String   @default("model3d")
  service       String   @default("webXR")
  glbUrl        String?  @map("glb_url")
  equirectUrl   String?  @map("equirect_url")
  usdzUrl       String?  @map("usdz_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenantId      String   @map("tenant_id")

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configurations  Configuration[]

  @@index([projectId])
  @@index([tenantId])
  @@map("xr_assets")
}

model Approval {
  id          String    @id @default(uuid())
  resource    String
  resourceId  String
  actorId     String
  actorRole   String
  status      String    @default("pending") // pending, approved, rejected
  notes       String?
  token       String    @unique @map("token")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenantId    String    @map("tenant_id")
  deployment  Deployment?

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([tenantId])
  @@map("approvals")
}

model Configuration {
  id         String   @id @default(uuid())
  xrAssetId  String   @map("xr_asset_id")
  name       String   @default("default")
  data       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  tenantId   String   @map("tenant_id")

  xrAsset XrAsset @relation(fields: [xrAssetId], references: [id], onDelete: Cascade)

  @@unique([xrAssetId, name])
  @@index([xrAssetId])
  @@index([tenantId])
  @@map("configurations")
}

model ConfiguratorSession {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  hostId      String    @map("host_id")
  config      String
  shareToken  String    @unique @map("share_token")
  isActive    Boolean   @default(true) @map("is_active")
  permissions Json      @default("{\"canEdit\": [], \"canView\": [], \"isPublic\": false}")
  startAt     DateTime? @map("start_at")
  reminderSentAt DateTime? @map("reminder_sent_at")
  gcalEventId String?   @map("gcal_event_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenantId    String    @map("tenant_id")

  viewers Viewer[]

  @@index([shareToken])
  @@index([hostId])
  @@index([startAt])
  @@index([tenantId])
  @@map("configurator_sessions")
}

model Viewer {
  id        String    @id @default(uuid())
  sessionId String    @map("session_id")
  userId    String?   @map("user_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  tenantId  String    @map("tenant_id")

  session ConfiguratorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId])
  @@map("viewers")
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  tenantId           String    @map("tenant_id")
  stripeCustomerId   String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String  @unique @map("stripe_subscription_id")
  stripePriceId      String    @map("stripe_price_id")
  tier               String
  status             String
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("subscriptions")
}
model Session {
  id              String    @id @default(cuid())
  email           String
  firstName       String
  lastName        String
  company         String?
  serviceId       String
  projectType     String
  notes           String?
  date            String
  time            String
  startAt         DateTime  @db.Timestamp(0)
  durationMinutes Int
  status          String    @default("CONFIRMED")
  reminderSentAt  DateTime? @db.Timestamp(0)
  gcalEventId     String?
  createdAt       DateTime  @default(now()) @db.Timestamp(0)

  @@index([email])
  @@index([status])
  @@index([startAt])
  @@map("sessions")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String    @map("actor_id")
  actorRole  String    @map("actor_role")
  action     String
  resource   String
  resourceId String?   @map("resource_id")
  changes    Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Annotation {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  authorId    String   @map("author_id")
  position    Json
  content     String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenantId    String   @map("tenant_id")

  @@index([projectId])
  @@index([authorId])
  @@index([tenantId])
  @@map("annotations")
}

model Comment {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  content   String
  mentions  String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenantId  String   @map("tenant_id")

  @@index([projectId])
  @@index([authorId])
  @@index([parentId])
  @@index([tenantId])
  @@map("comments")
}

model ApprovalWorkflow {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  requesterId String   @map("requester_id")
  approverId  String   @map("approver_id")
  status      String   @default("pending") // pending, approved, rejected
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenantId    String   @map("tenant_id")

  @@index([projectId])
  @@index([requesterId])
  @@index([approverId])
  @@index([tenantId])
  @@map("approval_workflows")
}

model Deliverable {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  name      String
  type      String
  url       String
  password  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenantId  String    @map("tenant_id")

  @@index([projectId])
  @@index([tenantId])
  @@map("deliverables")
}

model ProjectVersion {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  version   String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")
  tenantId  String   @map("tenant_id")

  @@index([projectId])
  @@index([tenantId])
  @@map("project_versions")
}

// M13: CRM models — leads, contacts, deals, tasks

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStage {
  PROSPECT
  QUOTE
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  company   String?
  phone     String?
  status    LeadStatus @default(NEW)
  source    String?
  tenantId  String     @map("tenant_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  contacts Contact[]
  deals    Deal[]
  tasks    Task[]

  @@index([tenantId])
  @@index([status])
  @@map("leads")
}

model Contact {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  name      String
  email     String?
  phone     String?
  role      String?
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([leadId])
  @@index([tenantId])
  @@map("contacts")
}

model Deal {
  id        String    @id @default(uuid())
  leadId    String    @map("lead_id")
  contactId String?   @map("contact_id")
  title     String
  stage     DealStage @default(PROSPECT)
  value     Decimal?  @db.Decimal(12, 2)
  currency  String    @default("USD")
  closeDate DateTime? @map("close_date")
  tenantId  String    @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  lead    Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact?  @relation(fields: [contactId], references: [id])
  tasks   Task[]

  @@index([leadId])
  @@index([stage])
  @@index([tenantId])
  @@map("deals")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime? @map("due_date")
  leadId      String?   @map("lead_id")
  dealId      String?   @map("deal_id")
  tenantId    String    @map("tenant_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dealId])
  @@index([tenantId])
  @@map("tasks")
}

// M13: Analytics tracking for page views and events
model PageView {
  id            String   @id @default(uuid())
  path          String
  projectId     String?  @map("project_id")
  visitorId     String?  @map("visitor_id")
  sessionId     String?  @map("session_id")
  referrer      String?
  userAgent     String?  @map("user_agent")
  country       String?
  device        String?
  browser       String?
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")
  tenantId      String   @map("tenant_id")

  @@index([path])
  @@index([projectId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("page_views")
}

model AiPrompt {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  template    String
  category    String?  // e.g. "xr", "content", "support"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenantId    String   @map("tenant_id")

  @@index([category])
  @@index([tenantId])
  @@map("ai_prompts")
}

model AiUsageLog {
  id          String   @id @default(uuid())
  promptSlug  String   @map("prompt_slug")
  userId      String?  @map("user_id")
  inputTokens Int?     @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  latencyMs   Int?     @map("latency_ms")
  success     Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")
  tenantId    String   @map("tenant_id")

  @@index([promptSlug])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("ai_usage_logs")
}


// M14: Admin/Support/Ops layer models
model DataExportRequest {
  id        String   @id @default(uuid())
  userId    String
  format    String   // e.g., "csv", "json", "pdf"
  status    String   @default("pending") // pending, processing, completed, failed
  filePath  String?
  requestedAt DateTime @default(now())
  completedAt DateTime?
  error     String?
  tenantId  String   @default("")

  // Relations
  user      User     @relation("DataExportRequestUserIdToUserId", fields: [userId], references: [id])
}

model ImpersonationLog {
  id        String   @id @default(uuid())
  adminUserId String   // The admin who initiated impersonation
  targetUserId String   // The user being impersonated
  status    String   @default("active") // active, revoked, expired
  expiresAt DateTime  // When the impersonation expires
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String   @default("")

  // Relations
  adminUser User     @relation("ImpersonationLogAdmin", fields: [adminUserId], references: [id])
  targetUser User     @relation("ImpersonationLogTarget", fields: [targetUserId], references: [id])
}

model JobExecution {
  id        String   @id @default(uuid())
  jobId     String   // Identifier for the job type (e.g., "rendering", "backup")
  status    String   @default("pending") // pending, running, completed, failed, cancelled
  progress  Int?     @default(0) // 0-100
  error     String?  // Error message if failed
  attempts  Int      @default(0)
  finishedAt DateTime?
  failedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String   @default("")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String?  // The initial message or description
  status    String   @default("open") // open, in_progress, resolved, closed
  priority  String   @default("low") // low, medium, high, urgent
  category  String   @default("general")
  tenantId  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?

  // Relations
  user      User            @relation("SupportTicketUserIdToUserId", fields: [userId], references: [id])
  messages  SupportMessage[] @relation("SupportMessageTicketIdToSupportTicket")
}


// M16: Communications models

model Conversation {
  id             String   @id @default(uuid())
  type           String   // direct, project, support, team
  title          String?
  projectId      String?  @map("project_id")
  participantIds String[] @map("participant_ids")
  lastMessageAt  DateTime @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages       Message[]

  @@index([projectId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  senderType     String   @map("sender_type") // user, admin, system, agent
  content        String
  messageType    String   @default("text") @map("message_type")
  metadata       Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tenantId     String   @map("tenant_id")
  category     String
  title        String
  body         String
  priority     String   @default("normal")
  channels     String[] @map("channels")
  data         Json?
  actionUrl    String?  @map("action_url")
  actionText   String?  @map("action_text")
  status       String   @default("pending") // pending, sent, failed
  readAt       DateTime? @map("read_at")
  createdAt    DateTime @default(now()) @map("created_at")

  deliveries   NotificationDelivery[]

  @@index([userId])
  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String   @map("notification_id")
  channel        String
  status         String   @default("pending") // pending, sent, failed
  messageId      String?  @map("message_id")
  error          String?
  sentAt         DateTime? @map("sent_at")

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@map("notification_deliveries")
}

model NotificationPreferences {
  userId    String   @id @map("user_id")
  email     Boolean  @default(true)
  inApp     Boolean  @default(true)
  telegram  Boolean  @default(false)
  discord   Boolean  @default(false)
  whatsapp  Boolean  @default(false)
  push      Boolean  @default(false)
  categories Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model NotificationChannelConfig {
  tenantId  String   @id @map("tenant_id")
  channel   String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_channel_configs")
}

model FAQItem {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  question     String
  answer       String
  category     String
  tags         String[]
  viewCount    Int      @default(0) @map("view_count")
  helpfulCount Int      @default(0) @map("helpful_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, question], name: "tenantId_question")
  @@index([tenantId])
  @@index([category])
  @@map("faq_items")
}

model SupportMessage {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  senderId    String   @map("sender_id")
  senderType  String   @map("sender_type") // user, agent, ai
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  ticket      SupportTicket @relation("SupportMessageTicketIdToSupportTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User        @relation("SupportMessageSenderIdToUserId", fields: [senderId], references: [id])

  @@index([ticketId])
  @@index([senderId])
  @@map("support_messages")
}

// M17: Enterprise & Marketplace models

enum MarketplaceItemType {
  TEMPLATE
  MATERIAL_PACK
  LIGHTING_PRESET
  FURNITURE_PACK
  CAMERA_PRESET
  SCRIPT
}

enum MarketplaceItemStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  UNLISTED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WebhookEvent {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_PUBLISHED
  QA_COMPLETED
  INVOICE_ISSUED
  SUBSCRIPTION_CHANGED
  PAYMENT_FAILED
  MARKETPLACE_PURCHASE
  MARKETPLACE_REVIEW
}

model BrandingConfig {
  id           String   @id @default(uuid())
  tenantId     String   @unique @map("tenant_id")
  logoUrl      String?  @map("logo_url")
  faviconUrl   String?  @map("favicon_url")
  primaryColor String?  @map("primary_color")
  secondaryColor String? @map("secondary_color")
  fontFamily   String?  @map("font_family")
  customCss    String?  @map("custom_css")
  whiteLabel   Boolean  @default(false) @map("white_label")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("branding_configs")
}

model CustomDomain {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  domain       String   @unique
  verified     Boolean  @default(false)
  sslEnabled   Boolean  @default(false) @map("ssl_enabled")
  sslExpiresAt DateTime? @map("ssl_expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("custom_domains")
}

model SsoConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  provider        String   // saml, oidc
  entityId        String?  @map("entity_id")
  ssoUrl          String?  @map("sso_url")
  certificate     String?
  attributeMapping Json    @default("{}") @map("attribute_mapping")
  autoProvision   Boolean  @default(true) @map("auto_provision")
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sso_configs")
}

model ApiKey {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  name        String
  keyHash     String       @map("key_hash")
  keyPrefix   String       @map("key_prefix")
  scopes      String[]
  status      ApiKeyStatus @default(ACTIVE)
  expiresAt   DateTime?    @map("expires_at")
  lastUsedAt  DateTime?    @map("last_used_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Webhook {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  url         String
  events      WebhookEvent[]
  secret      String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String   @map("webhook_id")
  event       WebhookEvent
  payload     Json
  response    Json?
  status      String   @default("pending") // pending, success, failed
  attempt     Int      @default(1)
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([webhookId])
  @@index([status])
  @@map("webhook_deliveries")
}

model MarketplaceItem {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  creatorId       String               @map("creator_id")
  type            MarketplaceItemType
  title           String
  description     String
  thumbnailUrl    String?              @map("thumbnail_url")
  previewUrls     String[]             @map("preview_urls")
  fileUrl         String?              @map("file_url")
  fileSize        Int?                 @map("file_size")
  version         String               @default("1.0.0")
  tags            String[]
  category        String
  price           Int                  @default(0) // in cents
  currency        String               @default("USD")
  commissionRate  Float                @default(0.2) @map("commission_rate")
  status          MarketplaceItemStatus @default(DRAFT)
  reviewNotes     String?              @map("review_notes")
  publishedAt     DateTime?            @map("published_at")
  salesCount      Int                  @default(0) @map("sales_count")
  revenue         Int                  @default(0)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  purchases       MarketplacePurchase[]

  @@index([tenantId])
  @@index([creatorId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@map("marketplace_items")
}

model MarketplacePurchase {
  id              String   @id @default(uuid())
  itemId          String   @map("item_id")
  buyerId         String   @map("buyer_id")
  sellerId        String   @map("seller_id")
  price           Int      // in cents
  currency        String   @default("USD")
  commission      Int      // in cents
  netAmount       Int      // in cents (seller receives)
  status          String   @default("completed") // completed, refunded, disputed
  purchasedAt     DateTime @default(now()) @map("purchased_at")

  item            MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("marketplace_purchases")
}

model CreatorPayout {
  id          String   @id @default(uuid())
  sellerId    String   @map("seller_id")
  amount      Int      // in cents
  currency    String   @default("USD")
  status      String   @default("pending") // pending, processing, paid, failed
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@index([status])
  @@map("creator_payouts")
}

model EnterpriseServer {
  id          String   @id @default(uuid())
  tenantId    String   @unique @map("tenant_id")
  name        String
  region      String
  instanceType String   @map("instance_type")
  gpuEnabled  Boolean  @default(false) @map("gpu_enabled")
  gpuType     String?  @map("gpu_type")
  status      String   @default("provisioning") // provisioning, active, suspended, terminated
  slaTier     String   @default("standard") @map("sla_tier") // standard, premium, enterprise
  ipAddress   String?  @map("ip_address")
  sshKey      String?  @map("ssh_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("enterprise_servers")
}